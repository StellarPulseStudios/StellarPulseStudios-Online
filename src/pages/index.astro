---
import Layout from '../layouts/Layout.astro';
import InstagramSection from '../components/InstagramSection.astro';
import { exhibitors, imageSize } from '../lib/exhibitors';
import { contact, currentEvent, mailto } from '../data/site';

// Datos estructurados de la organización para buscadores (schema.org).
const organizationData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Stellar Pulse Studios',
  url: new URL('/', Astro.site).href,
  logo: new URL('/brand/stellar-pulse-logo.webp', Astro.site).href,
  email: contact.email,
  sameAs: [contact.instagram],
  description:
    'Iniciativa de Toluca que crea experiencias y eventos para conectar personas, marcas y emprendimientos locales.',
};

// Constelación del hero: cada estrella es un emprendimiento del directorio.
// Posiciones deterministas (secuencia R2, bien repartida) para que no cambien
// en cada build. Se deja margen a la derecha para que quepan los nombres.
const stars = exhibitors.slice(0, 14).map((item, index) => ({
  name: item.name,
  slug: item.slug,
  x: 4 + 72 * ((index * 0.7548776662 + 0.5) % 1),
  y: 8 + 84 * ((index * 0.569840291 + 0.5) % 1),
  delay: (index % 5) * 0.7,
}));

// Unir cada estrella con sus dos vecinas más cercanas. El hero es más ancho
// que alto, así que la distancia horizontal pesa el doble.
const lineKeys = new Set<string>();
const lines: { x1: number; y1: number; x2: number; y2: number }[] = [];
stars.forEach((star, i) => {
  stars
    .map((other, j) => ({
      j,
      d: Math.hypot((star.x - other.x) * 2, star.y - other.y),
    }))
    .filter(({ j }) => j !== i)
    .sort((a, b) => a.d - b.d)
    .slice(0, 2)
    .forEach(({ j }) => {
      const key = [i, j].sort((a, b) => a - b).join('-');
      if (lineKeys.has(key)) return;
      lineKeys.add(key);
      lines.push({ x1: star.x, y1: star.y, x2: stars[j].x, y2: stars[j].y });
    });
});

// Reunir las imágenes de productos de todos los emprendimientos
const galleryImages = exhibitors.flatMap((item) =>
  (item.images ?? [])
    .filter((image) => Boolean(image))
    .map((image) => ({
      src: image,
      name: item.name,
      size: imageSize(item, image),
    }))
);

// Distribuir las imágenes en dos filas
const firstRow = galleryImages.filter((_, index) => index % 2 === 0);
const secondRow = galleryImages
  .filter((_, index) => index % 2 !== 0)
  .reverse();

const formats = [
  {
    glyph: '♫',
    title: 'Noches con música en vivo',
    text: 'Artistas locales y un ambiente hecho para quedarse.',
  },
  {
    glyph: '✶',
    title: 'Posadas y temporadas',
    text: 'Ediciones especiales como Stellar Nights Christmas.',
  },
  {
    glyph: '▣',
    title: 'Exposiciones',
    text: 'Arte, diseño y producto local con curaduría.',
  },
  {
    glyph: '✺',
    title: 'Experiencias poco comunes',
    text: 'Formatos nuevos en lugares que no esperas.',
  },
];

const services = [
  {
    title: 'Asesoría de negocio',
    text: 'Precios, permisos, finanzas y primeros pasos.',
  },
  {
    title: 'Contenido digital',
    text: 'Fotografía, video y redes sociales para tu marca.',
  },
  {
    title: 'Recursos digitales',
    text: 'Identidad, diseño y materiales listos para usar.',
  },
  {
    title: 'Sitios web',
    text: 'Tu página o tienda en línea, sencilla y funcional.',
  },
];

const paths = [
  {
    title: 'Tengo un emprendimiento',
    text: 'Quiero participar en un evento o recibir apoyo.',
    cta: 'Escríbenos',
    subject: 'Quiero participar con mi emprendimiento',
  },
  {
    title: 'Soy experto o creativo',
    text: 'Quiero sumarme a la red y apoyar a otros emprendedores.',
    cta: 'Quiero colaborar',
    subject: 'Quiero colaborar con la red de expertos',
  },
  {
    title: 'Represento una marca',
    text: 'Quiero patrocinar o aliarme en un evento.',
    cta: 'Hablemos',
    subject: 'Patrocinio y alianzas',
  },
];
---

<Layout
  title="Stellar Pulse | Experiencias que conectan"
  description="Stellar Pulse crea experiencias en Toluca, como música en vivo, posadas y exposiciones, que conectan personas, marcas y emprendimientos locales."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationData)}
  />

  <section class="sp-hero">
    <div class="sky" aria-hidden="true">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="sky-lines">
        {lines.map((line) => (
          <line
            x1={line.x1}
            y1={line.y1}
            x2={line.x2}
            y2={line.y2}
            vector-effect="non-scaling-stroke"
          />
        ))}
      </svg>
    </div>

    <nav class="stars" aria-label="Algunos emprendimientos de la comunidad">
      {stars.map((star) => (
        <a
          class="star"
          href={`/emprendimientos/${star.slug}/`}
          style={`left:${star.x}%;top:${star.y}%;--delay:${star.delay}s`}
        >
          <span class="star-dot" aria-hidden="true"></span>
          <span class="star-name">{star.name}</span>
        </a>
      ))}
    </nav>

    <div class="container sp-hero-inner">
      <a class="next-pill" href={currentEvent.path}>
        <span class="next-pill-date">5 DIC</span>
        Próximo evento: {currentEvent.fullName}
        <span aria-hidden="true">→</span>
      </a>

      <h1>
        Experiencias que <em>conectan</em> personas, marcas y comunidad.
      </h1>

      <p class="sp-hero-lead">
        Somos una iniciativa de Toluca que crea eventos poco comunes, con
        música en vivo, posadas, exposiciones y noches especiales, para que
        los emprendimientos locales encuentren a su público de forma
        orgánica.
      </p>

      <div class="sp-actions">
        <a href="#nosotros" class="button button-primary">
          Conoce Stellar Pulse
        </a>
        <a href="/emprendimientos/" class="button button-secondary">
          Explorar emprendimientos →
        </a>
      </div>
    </div>
  </section>

  <section class="gallery-section" aria-label="Galería de productos de los emprendimientos">
    <div class="gallery-heading">
      <span class="eyebrow">Descubre. Explora. Conecta.</span>
      <h2>Un vistazo a lo extraordinario.</h2>
      <p>
        Ideas, productos y propuestas únicas de las marcas que dan vida
        a nuestra comunidad.
      </p>
    </div>

    {
      galleryImages.length > 0 ? (
        <div class="gallery-viewport">
          <div class="gallery-row">
            <div class="gallery-track">
              {[0, 1].map((copy) => (
                <div class="gallery-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {firstRow.map((image) => (
                    <figure class="gallery-item">
                      <img
                        src={image.src}
                        {...image.size}
                        alt={copy === 0 ? `Producto de ${image.name}` : ''}
                        loading="lazy"
                        decoding="async"
                      />
                      <figcaption>{image.name}</figcaption>
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          </div>

          {
            secondRow.length > 0 && (
              <div class="gallery-row gallery-row-secondary">
                <div class="gallery-track">
                  {[0, 1].map((copy) => (
                    <div class="gallery-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                      {secondRow.map((image) => (
                        <figure class="gallery-item">
                          <img
                            src={image.src}
                            {...image.size}
                            alt={copy === 0 ? `Producto de ${image.name}` : ''}
                            loading="lazy"
                            decoding="async"
                          />
                          <figcaption>{image.name}</figcaption>
                        </figure>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      ) : (
        <p class="gallery-empty">
          Muy pronto descubrirás aquí los productos de nuestra comunidad.
        </p>
      )
    }
  </section>


  <section class="about" id="nosotros">
    <div class="container about-grid">
      <div>
        <span class="eyebrow">Quiénes somos</span>
        <p class="about-statement">
          No somos un bazar. Creamos <mark>momentos</mark> en los que la
          gente llega por la experiencia y se va conociendo marcas locales
          que no sabía que existían.
        </p>
      </div>

      <div class="pillars">
        <div class="pillar">
          <span class="pillar-icon" aria-hidden="true">✦</span>
          <div>
            <h3>Experiencias</h3>
            <p>
              Cada evento tiene un concepto, música, ambiente y una razón
              para ir más allá de comprar.
            </p>
          </div>
        </div>
        <div class="pillar">
          <span class="pillar-icon" aria-hidden="true">⟡</span>
          <div>
            <h3>Comunidad</h3>
            <p>
              Emprendedores que se conocen, se recomiendan y crecen juntos
              de un evento al siguiente.
            </p>
          </div>
        </div>
        <div class="pillar">
          <span class="pillar-icon" aria-hidden="true">◎</span>
          <div>
            <h3>Exposición orgánica</h3>
            <p>
              Una plataforma para mostrarse ante un público que llega con
              ganas de descubrir.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="formats-section">
    <div class="container">
      <span class="eyebrow">Lo que hacemos</span>
      <h2 class="sp-title">Eventos que no se parecen entre sí.</h2>

      <div class="formats">
        {formats.map((format, index) => (
          <article class:list={['format', { 'format-featured': index === 0 }]}>
            <span class="format-glyph" aria-hidden="true">{format.glyph}</span>
            <div>
              <h3>{format.title}</h3>
              <p>{format.text}</p>
            </div>
          </article>
        ))}
      </div>

      <p class="formats-note">
        <strong>Cada edición es distinta.</strong> Lo que no cambia es que
        conectamos gente con marcas locales.
      </p>
    </div>
  </section>

  <section class="allies" id="colabora">
    <div class="container">
      <div class="allies-grid">
        <div>
          <span class="eyebrow">Red de expertos</span>
          <h2 class="sp-title">Si vas empezando, no tienes que hacerlo solo.</h2>
          <p class="allies-lead">
            Colaboramos con especialistas que acompañan a emprendimientos
            locales en lo que más cuesta al principio. Te ponemos en
            contacto con quien te puede ayudar.
          </p>
        </div>

        <div class="services">
          {services.map((service) => (
            <div class="service">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="paths">
        {paths.map((path) => (
          <div class="path">
            <h3>{path.title}</h3>
            <p>{path.text}</p>
            <a href={mailto(path.subject)}>{path.cta} →</a>
          </div>
        ))}
      </div>

      <p class="allies-mail">
        Estamos abiertos a colaborar. Escríbenos a{' '}
        <strong>{contact.email}</strong>
      </p>
    </div>
  </section>

  <section class="teaser-section">
    <div class="container">
      <a class="teaser" href={currentEvent.path}>
        <div class="teaser-date">
          <small>{currentEvent.month}</small>
          <strong>{currentEvent.day}</strong>
        </div>
        <div class="teaser-copy">
          <span class="eyebrow">Próximo evento</span>
          <h2>{currentEvent.fullName}</h2>
          <p>{currentEvent.timeLabel} · {currentEvent.venue.name}, Toluca</p>
        </div>
        <span class="button button-primary teaser-cta">Ver el evento</span>
      </a>
    </div>
  </section>

  <section class="join-section">
    <div class="container">
      <div class="join">
        <div>
          <span class="eyebrow">Únete a la comunidad</span>
          <h2 class="sp-title">Emprendedores que se acompañan.</h2>
          <p>
            Entérate primero de los próximos eventos, convocatorias para
            exponer y talleres con nuestra red de expertos. Escríbenos y te
            sumamos a la comunidad de emprendedores de Stellar Pulse.
          </p>
        </div>
        <div class="join-box">
          <a
            class="button button-primary"
            href={mailto('Quiero unirme a la comunidad de Stellar Pulse')}
          >
            Quiero unirme a la comunidad
          </a>
          <span class="join-mail">{contact.email}</span>
          <a class="join-more" href="/emprendimientos/">
            o explora los emprendimientos participantes →
          </a>
        </div>
      </div>
    </div>
  </section>

  <InstagramSection />

  <div class="thanks">
    <span>Gracias a quienes creen en esto</span>
    <a href={currentEvent.path + '#patrocinador'} aria-label={`Patrocinador: ${currentEvent.sponsor.name}`}>
      <img
        src={currentEvent.sponsor.logo}
        width="480"
        height="416"
        alt={currentEvent.sponsor.name}
        loading="lazy"
      />
    </a>
  </div>
</Layout>

<style>
  /* ===== Hero con constelación ===== */
  .sp-hero {
    position: relative;
    overflow: hidden;
    padding: 84px 0 72px;
  }

  .sky,
  .stars {
    position: absolute;
    inset: 32px 0 24px 46%;
  }

  .sky-lines {
    width: 100%;
    height: 100%;
  }

  .sky-lines line {
    stroke: rgba(244, 198, 106, 0.22);
    stroke-width: 1;
  }

  .star {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translate(-7px, -7px);
    color: rgba(245, 246, 255, 0.6);
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .star:hover,
  .star:focus-visible {
    color: var(--accent);
  }

  .star-dot {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(244, 198, 106, 0.18);
    animation: twinkle 3.6s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .star-dot::after {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px rgba(244, 198, 106, 0.8);
    content: '';
  }

  .star:hover .star-dot {
    background: rgba(244, 198, 106, 0.4);
  }

  @keyframes twinkle {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.7; }
  }

  .sp-hero-inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 22px;
    pointer-events: none;
  }

  .sp-hero-inner > * {
    pointer-events: auto;
  }

  .next-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    border: 1px solid rgba(244, 198, 106, 0.35);
    border-radius: 99px;
    background: rgba(8, 11, 24, 0.75);
    font-size: 0.82rem;
    transition: border-color 160ms ease;
  }

  .next-pill:hover {
    border-color: var(--accent);
  }

  .next-pill-date {
    white-space: nowrap;
    padding: 3px 10px;
    border-radius: 99px;
    background: var(--accent);
    color: #17120a;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .sp-hero h1 {
    max-width: 11.5ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6.4vw, 5.2rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .sp-hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .sp-hero-lead {
    max-width: 520px;
    margin: 0;
    color: #cfd5e6;
    font-size: 1.08rem;
  }

  .sp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ===== Tipografía de secciones ===== */
  .sp-title {
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* ===== Quiénes somos ===== */
  .about {
    padding: 90px 0 70px;
    scroll-margin-top: 20px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .about-statement {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.9vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .about-statement mark {
    background: none;
    color: var(--accent);
  }

  .pillars {
    border-top: 1px solid var(--border);
  }

  .pillar {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 14px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }

  .pillar-icon {
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .pillar h3 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.12rem;
  }

  .pillar p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* ===== Formatos ===== */
  .formats-section {
    padding: 20px 0 90px;
  }

  .formats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 34px;
  }

  .format {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    min-height: 220px;
    padding: 24px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .format-featured {
    border-color: rgba(143, 128, 204, 0.4);
    background: linear-gradient(160deg, #2a2148, #121a30);
  }

  .format-glyph {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1;
  }

  .format h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .format p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .formats-note {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .formats-note strong {
    color: var(--text);
  }

  /* ===== Red de expertos (bloque claro) ===== */
  .allies {
    padding: 90px 0;
    background: #f6f3ec;
    color: #141a2c;
    scroll-margin-top: 20px;
  }

  .allies .eyebrow {
    color: #8a5d0c;
  }

  .allies-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
    align-items: start;
  }

  .allies-lead {
    max-width: 520px;
    margin: 14px 0 0;
    color: #4a5068;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .service {
    padding: 18px;
    border: 1px solid #e6e0d2;
    border-radius: 14px;
    background: #fff;
  }

  .service h3 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.02rem;
  }

  .service p {
    margin: 0;
    color: #4a5068;
    font-size: 0.88rem;
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 44px;
  }

  .path {
    display: grid;
    align-content: start;
    gap: 6px;
    padding-top: 14px;
    border-top: 2px solid #141a2c;
  }

  .path h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .path p {
    margin: 0;
    color: #4a5068;
    font-size: 0.9rem;
  }

  .path a {
    color: #7a520a;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .path a:hover {
    text-decoration: underline;
  }

  .allies-mail {
    margin: 30px 0 0;
    color: #4a5068;
    font-size: 0.92rem;
  }

  .allies-mail strong {
    color: #141a2c;
    user-select: all;
  }

  .allies a:focus-visible {
    outline-color: #7a520a;
  }

  /* ===== Próximo evento ===== */
  .teaser-section {
    padding: 80px 0 30px;
  }

  .teaser {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 30px;
    align-items: center;
    padding: 28px 30px;
    border: 1px solid rgba(244, 198, 106, 0.28);
    border-radius: 22px;
    background:
      radial-gradient(ellipse at 85% 20%, rgba(102, 85, 158, 0.3), transparent 50%),
      linear-gradient(135deg, #11182c, #090e1d);
    transition: border-color 160ms ease;
  }

  .teaser:hover {
    border-color: var(--accent);
  }

  .teaser-date {
    padding-right: 30px;
    border-right: 1px solid var(--border);
    text-align: center;
  }

  .teaser-date small {
    display: block;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .teaser-date strong {
    display: block;
    font-family: var(--font-display);
    font-size: 3.8rem;
    font-weight: 800;
    line-height: 1;
  }

  .teaser-copy h2 {
    margin: 6px 0 2px;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    line-height: 1.15;
  }

  .teaser-copy p {
    margin: 0;
