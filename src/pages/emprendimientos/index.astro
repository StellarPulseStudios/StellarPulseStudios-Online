---
import Layout from '../../layouts/Layout.astro';
import ExhibitorCard from '../../components/ExhibitorCard.astro';
import { exhibitors } from '../../lib/exhibitors';

const categories = [
  ...new Set(exhibitors.map((item) => item.category)),
].sort((a, b) => a.localeCompare(b, 'es'));
---

<Layout
  title="Emprendimientos participantes | Stellar Pulse"
  description="Explora el directorio de emprendimientos participantes de Stellar Pulse."
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">
        Directorio de participantes
      </span>

      <h1>
        Conoce a los<br />
        <span>emprendimientos.</span>
      </h1>

      <p>
        Explora las marcas participantes, descubre sus productos
        y encuentra nuevas opciones para ti.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Todos los participantes</h2>

          <p data-results-count aria-live="polite">
            {exhibitors.length} emprendimientos publicados.
          </p>
        </div>
      </div>

      {
        categories.length > 1 && (
          <div
            class="category-filter"
            role="group"
            aria-label="Filtrar por categoría"
            data-category-filter
          >
            <button
              type="button"
              class="category-chip"
              aria-pressed="true"
              data-category=""
            >
              Todas
            </button>

            {categories.map((category) => (
              <button
                type="button"
                class="category-chip"
                aria-pressed="false"
                data-category={category}
              >
                {category}
              </button>
            ))}
          </div>
        )
      }

      {
        exhibitors.length > 0 ? (
          <div class="exhibitor-grid">
            {exhibitors.map((item) => (
              <ExhibitorCard item={item} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            Estamos preparando el directorio.
            Pronto podrás conocer a los emprendimientos participantes.
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .category-chip {
    min-height: 40px;
    padding: 8px 16px;

    border: 1px solid rgba(244, 198, 106, 0.25);
    border-radius: 999px;

    background: transparent;
    color: var(--accent);

    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;

    cursor: pointer;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .category-chip:hover {
    background: var(--accent-soft);
  }

  .category-chip[aria-pressed='true'] {
    background: var(--accent);
    color: #080b18;
  }

  .category-chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>

<script>
  const filter = document.querySelector<HTMLElement>('[data-category-filter]');
  const chips = Array.from(
    filter?.querySelectorAll<HTMLButtonElement>('[data-category]') ?? []
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('.exhibitor-grid [data-category]')
  );
  const counter = document.querySelector<HTMLElement>('[data-results-count]');

  function applyFilter(category: string) {
    let visible = 0;

    cards.forEach((card) => {
      const show = !category || card.dataset.category === category;
      card.hidden = !show;
      if (show) visible++;
    });

    chips.forEach((chip) => {
      chip.setAttribute(
        'aria-pressed',
        String((chip.dataset.category ?? '') === category)
      );
    });

    if (counter) {
      counter.textContent = category
        ? `${visible} de ${cards.length} emprendimientos en ${category}.`
        : `${cards.length} emprendimientos publicados.`;
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const category = chip.dataset.category ?? '';
      applyFilter(category);

      // Guardar el filtro en la URL para poder compartirlo.
      const url = new URL(window.location.href);
      if (category) {
        url.searchParams.set('categoria', category);
      } else {
        url.searchParams.delete('categoria');
      }
      history.replaceState(null, '', url);
    });
  });

  const initial = new URLSearchParams(window.location.search).get('categoria');
  if (initial && chips.some((chip) => chip.dataset.category === initial)) {
    applyFilter(initial);
  }
</script>