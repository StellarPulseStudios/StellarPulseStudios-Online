---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Stellar Pulse | Emprendimientos y experiencias',
  description = 'Descubre los emprendimientos participantes de Stellar Pulse.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b18" />

    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <!-- Logo e identidad de Stellar Pulse -->
      <a
        class="brand"
        href="/"
        aria-label="Stellar Pulse, ir al inicio"
      >
        <img
          class="brand-logo"
          src="/stellar-pulse-logo.png"
          alt="Stellar Pulse"
          width="180"
          height="60"
        />

        <span class="brand-text">
          <strong>STELLAR PULSE</strong>
          <small>Emprendimientos &amp; experiencias</small>
        </span>
      </a>

      <!-- Botón del menú móvil -->
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-controls="primary-navigation"
        aria-expanded="false"
      >
        <span class="menu-toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <!-- Navegación principal -->
      <nav
        class="main-nav"
        id="primary-navigation"
        aria-label="Navegación principal"
        data-open="false"
      >
        <a href="/" data-nav-link>Inicio</a>

        <a href="/emprendimientos/" data-nav-link>
          Emprendimientos
        </a>

        <a href="/#evento" data-nav-link>
          El evento
        </a>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <a href="/" class="footer-brand">
        STELLAR PULSE
      </a>

      <p>
        Una comunidad que conecta emprendimientos, experiencias y personas.
      </p>

      <small>
        © {new Date().getFullYear()} Stellar Pulse
      </small>
    </footer>

    <!-- Comportamiento del menú móvil -->
    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>(
        '.menu-toggle'
      );

      const navigation = document.querySelector<HTMLElement>(
        '#primary-navigation'
      );

      const navigationLinks =
        navigation?.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

      function setMenuOpen(open: boolean) {
        if (!menuToggle || !navigation) return;

        menuToggle.setAttribute('aria-expanded', String(open));

        menuToggle.setAttribute(
          'aria-label',
          open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
        );

        navigation.dataset.open = String(open);
      }

      menuToggle?.addEventListener('click', () => {
        const isOpen =
          menuToggle.getAttribute('aria-expanded') === 'true';

        setMenuOpen(!isOpen);
      });

      // Cerrar el menú después de seleccionar una opción.
      navigationLinks?.forEach((link) => {
        link.addEventListener('click', () => {
          setMenuOpen(false);
        });
      });

      // Permitir cerrar el menú con Escape.
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMenuOpen(false);
          menuToggle?.focus();
        }
      });

      // Restablecer el estado al cambiar de móvil a escritorio.
      const desktopMediaQuery = window.matchMedia('(min-width: 801px)');

      desktopMediaQuery.addEventListener('change', (event) => {
        if (event.matches) {
          setMenuOpen(false);
        }
      });
    </script>
  </body>
</html>