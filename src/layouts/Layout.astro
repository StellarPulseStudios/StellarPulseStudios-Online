---
import '../styles/global.css';
import { contact, currentEvent } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL de la imagen para compartir en redes. */
  image?: string;
}

const {
  title = 'Stellar Pulse | Emprendimientos y experiencias',
  description = 'Descubre los emprendimientos participantes de Stellar Pulse.',
  image = '/brand/og-default.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b18" />

    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap"
    />

    <!-- Vista previa al compartir en WhatsApp, Instagram, Facebook, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Stellar Pulse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <slot name="head" />
  </head>

  <body>
    <header class="site-header">
      <!-- Logo e identidad de Stellar Pulse -->
      <a
        class="brand"
        href="/"
        aria-label="Stellar Pulse, ir al inicio"
      >
        <img
          class="brand-logo"
          src="/brand/stellar-pulse-logo.webp"
          alt="Stellar Pulse"
          width="192"
          height="192"
        />

        <span class="brand-text">
          <strong>STELLAR PULSE</strong>
          <small>Experiencias que conectan</small>
        </span>
      </a>

      <!-- Botón del menú móvil -->
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-controls="primary-navigation"
        aria-expanded="false"
      >
        <span class="menu-toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <!-- Navegación principal -->
      <nav
        class="main-nav"
        id="primary-navigation"
        aria-label="Navegación principal"
        data-open="false"
      >
        <a href="/" data-nav-link aria-current={isCurrent('/') ? 'page' : undefined}>Inicio</a>

        <a href="/#nosotros" data-nav-link>Nosotros</a>

        <a
          href="/emprendimientos/"
          data-nav-link
          aria-current={isCurrent('/emprendimientos/') ? 'page' : undefined}
        >
          Emprendimientos
        </a>

        <a
          href={currentEvent.path}
          data-nav-link
          aria-current={isCurrent('/eventos/') ? 'page' : undefined}
        >
          {currentEvent.name}
        </a>

        <a
          href={currentEvent.ticketsUrl}
          class="nav-tickets"
          target="_blank"
          rel="noopener noreferrer"
          data-nav-link
        >
          Boletos <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <a href="/" class="footer-brand">
        STELLAR PULSE
      </a>

      <p>
        Una comunidad que conecta emprendimientos, experiencias y personas.
      </p>

      <nav class="footer-links" aria-label="Enlaces del pie de página">
        <a href="/#nosotros">Nosotros</a>
        <a href="/emprendimientos/">Emprendimientos</a>
        <a href={currentEvent.path}>{currentEvent.name}</a>
        <a href="/#colabora">Colabora</a>
        <a href={contact.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      </nav>

      <p class="footer-mail">{contact.email}</p>

      <small>
        © {new Date().getFullYear()} Stellar Pulse
      </small>
    </footer>

    <!-- Comportamiento del menú móvil -->
    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>(
        '.menu-toggle'
      );

      const navigation = document.querySelector<HTMLElement>(
        '#primary-navigation'
      );

      const navigationLinks =
        navigation?.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

      function setMenuOpen(open: boolean) {
        if (!menuToggle || !navigation) return;

        menuToggle.setAttribute('aria-expanded', String(open));

        menuToggle.setAttribute(
          'aria-label',
          open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
        );

        navigation.dataset.open = String(open);
      }

      menuToggle?.addEventListener('click', () => {
        const isOpen =
          menuToggle.getAttribute('aria-expanded') === 'true';

        setMenuOpen(!isOpen);
      });

      // Cerrar el menú después de seleccionar una opción.
      navigationLinks?.forEach((link) => {
        link.addEventListener('click', () => {
          setMenuOpen(false);
        });
      });

      // Permitir cerrar el menú con Escape.
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMenuOpen(false);
          menuToggle?.focus();
        }
      });

      // Restablecer el estado al cambiar de móvil a escritorio.
      const desktopMediaQuery = window.matchMedia('(min-width: 801px)');

      desktopMediaQuery.addEventListener('change', (event) => {
        if (event.matches) {
          setMenuOpen(false);
        }
      });
    </script>
  </body>
</html>