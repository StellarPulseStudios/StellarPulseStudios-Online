
---
import type { Exhibitor } from '../lib/notion';
import { getSocialLinks, getWhatsappUrl } from '../lib/links';
import { imageSize } from '../lib/exhibitors';

interface Props {
  item: Exhibitor;
}

const { item } = Astro.props;

const whatsappUrl = getWhatsappUrl(item.whatsapp);

// En la tarjeta solo se muestran los dos primeros canales para no saturarla;
// la ficha completa tiene todos.
const socialLinks = getSocialLinks(item).slice(0, 2);

const profileUrl = `/emprendimientos/${item.slug}/`;
---

<article class="exhibitor-card" data-category={item.category}>
  <div class="card-content">
    <div class="exhibitor-header">
      {
        item.logo ? (
          <img
            src={item.logo}
            {...imageSize(item, item.logo)}
            alt={`Logotipo de ${item.name}`}
            class="exhibitor-logo"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="logo-placeholder" aria-hidden="true">
            {item.name.slice(0, 1).toUpperCase()}
          </div>
        )
      }

      <div>
        <h3 class="exhibitor-name">
          <a href={profileUrl}>{item.name}</a>
        </h3>

        <span class="category">{item.category}</span>
      </div>
    </div>

    {
      item.description && (
        <p class="exhibitor-description">
          {item.description}
        </p>
      )
    }

    {
      item.promo && (
        <div class="promo">
          <strong>Promoción:</strong> {item.promo}
        </div>
      )
    }
  </div>

  <div class="card-footer">
    <a class="card-link" href={profileUrl}>
      Conocer marca →
    </a>
    
    {
      whatsappUrl && (
        <a
          class="card-link"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Escribir por WhatsApp a ${item.name}`}
        >
          WhatsApp ↗
        </a>
      )
    }

    {
      socialLinks.map((social) => (
        <a
          class="card-link"
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${social.label} de ${item.name}`}
        >
          {social.label} ↗
        </a>
      ))
    }
  </div>
</article>
