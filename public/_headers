# Caché en Cloudflare (Workers Static Assets).

# Archivos de Astro: el nombre incluye un hash del contenido.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes de Notion: el nombre cambia si cambia el archivo en Notion.
/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800
